from dotenv import dotenv_values

config = dotenv_values(".env")

for key, value in config.items():
    if value:
        masked = value[:4] + "..." + value[-4:] if len(value) > 8 else "***"
    else:
        masked = "<empty>"
    print(f"{key} = {masked}")








